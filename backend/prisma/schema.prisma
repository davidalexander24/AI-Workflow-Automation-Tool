generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String
  // Step 1 of the workflow.
  promptTemplate String
  // Follow-up steps run after promptTemplate, in order:
  // [{ name, promptTemplate, model? }]
  steps          Json          @default("[]")
  // Curated examples: readable and runnable by anyone, not editable or
  // deletable through the API, and exempt from the demo cleanup.
  locked         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  runs           WorkflowRun[]
}

model WorkflowRun {
  id           String            @id @default(uuid()) @db.Uuid
  workflowId   String            @db.Uuid
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  inputData    Json
  outputResult String
  status       WorkflowRunStatus @default(pending)
  // The model that produced the output. When a fallback answered, the model
  // that was asked for is kept in fallbackFrom.
  model            String?
  fallbackFrom     String?
  temperature      Float?
  attempts         Int?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  // Multi-step runs only: one entry per executed step with its output,
  // model, latency, and tokens. Run-level latency, tokens and attempts are
  // totals across steps.
  stepResults      Json?
  createdAt        DateTime          @default(now())

  @@index([workflowId, createdAt(sort: Desc)])
}

enum WorkflowRunStatus {
  pending
  success
  failed
}
