generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workflow {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  description    String
  promptTemplate String
  createdAt      DateTime      @default(now())
  runs           WorkflowRun[]
}

model WorkflowRun {
  id           String            @id @default(uuid()) @db.Uuid
  workflowId   String            @db.Uuid
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  inputData    Json
  outputResult String
  status       WorkflowRunStatus @default(pending)
  // The model that produced the output. When a fallback answered, the model
  // that was asked for is kept in fallbackFrom.
  model            String?
  fallbackFrom     String?
  temperature      Float?
  attempts         Int?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime          @default(now())

  @@index([workflowId, createdAt(sort: Desc)])
}

enum WorkflowRunStatus {
  pending
  success
  failed
}
