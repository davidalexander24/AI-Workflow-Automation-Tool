DATABASE_URL=postgresql://user:password@host:5432/dbname
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: only required for Groq (free) models. Get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# Optional: only required for OpenRouter models. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional: Cloudflare Workers AI models (Llama 4, Mistral, GLM, Granite).
# Needs an API token with Workers AI permission plus the account ID shown in
# the Cloudflare dashboard URL.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional: comma-separated CORS allowlist. Defaults to the production
# frontend origin plus http://localhost:3000 and http://localhost:3001.
CORS_ORIGINS=
# Optional: delete unlocked (non-example) workflows older than this many
# hours. 0 or unset keeps everything. docker-compose defaults it to 72.
DEMO_WORKFLOW_TTL_HOURS=0
